# Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543) for Vercel,
# "Session pooler" (port 5432) for migrations and imports.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/koshava

# Comma-separated emails that get admin access on sign-up / sign-in.
ADMIN_EMAILS=

# Official Lidl Srbija price list and sister barcodes (published daily, mirrored on data.gov.rs).
LIDL_PRICES_CSV_URL=https://www.lidl.rs/explore/assets/webPriceData/rs/cene_proizvoda_Lidl.csv
LIDL_EAN_CSV_URL=https://www.lidl.rs/explore/assets/webPriceData/rs/EAN.csv

# true = show every price-list product, with a placeholder when there is no photo.
PUBLISH_WITHOUT_IMAGE=false

# Open Food Facts asks API clients to identify themselves, ideally with a contact.
OFF_USER_AGENT=Koshava/0.1 (pilot grocery delivery in Belgrade)
